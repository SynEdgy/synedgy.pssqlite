        },
        { "anyOf": [{ "$ref": "#/definitions/hasSql" }, { "$ref": "#/definitions/hasFrom" }] },
        {
          "if": { "$ref": "#/definitions/hasSql" },
          "then": {
            "propertyNames": {
              "not": { "pattern": "^(?:[Ff][Rr][Oo][Mm]|[Jj][Oo][Ii][Nn][Ss]|[Ww][Hh][Ee][Rr][Ee]|[Gg][Rr][Oo][Uu][Pp][Bb][Yy]|[Hh][Aa][Vv][Ii][Nn][Gg]|[Oo][Rr][Dd][Ee][Rr][Bb][Yy])$" }
            },
            "patternProperties": {
              "^[Dd][Ii][Ss][Tt][Ii][Nn][Cc][Tt]$": { "const": false },
              "^[Ss][Ee][Ll][Ee][Cc][Tt]$": {
                "patternProperties": { "^[Dd][Ii][Ss][Tt][Ii][Nn][Cc][Tt]$": { "const": false } }
              }
            }
          },
          "else": {
            "patternProperties": {
              "^[Cc][Oo][Ll][Uu][Mm][Nn][Ss]$": { "$ref": "#/definitions/structuredViewColumns" },
              "^[Ss][Ee][Ll][Ee][Cc][Tt]$": {
                "patternProperties": { "^[Cc][Oo][Ll][Uu][Mm][Nn][Ss]$": { "$ref": "#/definitions/structuredViewColumns" } }
