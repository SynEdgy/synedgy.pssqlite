              "^[Nn][Aa][Mm][Ee]$": { "$ref": "#/definitions/text" },
              "^[Tt][Aa][Bb][Ll][Ee]$": { "$ref": "#/definitions/text" },
              "^[Aa][Ll][Ii][Aa][Ss]$": { "$ref": "#/definitions/text" },
              "^[Ee][Xx][Pp][Rr][Ee][Ss][Ss][Ii][Oo][Nn]$": { "$ref": "#/definitions/text" },
              "^[Dd][Ii][Rr][Ee][Cc][Tt][Ii][Oo][Nn]$": { "enum": ["ASC", "DESC", "asc", "desc"] }
            },
            "additionalProperties": false,
            "not": { "propertyNames": { "not": { "pattern": "^(?:[Cc][Oo][Ll][Uu][Mm][Nn]|[Nn][Aa][Mm][Ee]|[Ee][Xx][Pp][Rr][Ee][Ss][Ss][Ii][Oo][Nn])$" } } }
          }
        ]
      }
    },
    "select": {
      "type": "object",
      "properties": { "Columns": { "$ref": "#/definitions/viewColumns" }, "Distinct": { "type": "boolean" } },
      "patternProperties": {
        "^[Cc][Oo][Ll][Uu][Mm][Nn][Ss]$": { "$ref": "#/definitions/viewColumns" },
        "^[Dd][Ii][Ss][Tt][Ii][Nn][Cc][Tt]$": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "Schema": { "$ref": "#/definitions/text" }, "IfNotExists": { "type": "boolean", "default": true },
        "Columns": { "$ref": "#/definitions/viewColumns" }, "Select": { "$ref": "#/definitions/select" },
        "Distinct": { "type": "boolean" }, "Sql": { "$ref": "#/definitions/text" },
        "From": { "$ref": "#/definitions/source" }, "Joins": { "type": "array", "items": { "$ref": "#/definitions/join" } },
        "Where": { "$ref": "#/definitions/condition" }, "Having": { "$ref": "#/definitions/condition" },
        "GroupBy": { "$ref": "#/definitions/groupBy" }, "OrderBy": { "$ref": "#/definitions/orderBy" }
      },
      "patternProperties": {
        "^[Ss][Cc][Hh][Ee][Mm][Aa]$": { "$ref": "#/definitions/text" },
        "^[Ii][Ff][Nn][Oo][Tt][Ee][Xx][Ii][Ss][Tt][Ss]$": { "type": "boolean" },
        "^[Cc][Oo][Ll][Uu][Mm][Nn][Ss]$": { "$ref": "#/definitions/viewColumns" },
        "^[Ss][Ee][Ll][Ee][Cc][Tt]$": { "$ref": "#/definitions/select" },
        "^[Dd][Ii][Ss][Tt][Ii][Nn][Cc][Tt]$": { "type": "boolean" },
        "^[Ss][Qq][Ll]$": { "$ref": "#/definitions/text" },
        "^[Ff][Rr][Oo][Mm]$": { "$ref": "#/definitions/source" },
        "^[Jj][Oo][Ii][Nn][Ss]$": { "type": "array", "items": { "$ref": "#/definitions/join" } },
        "^[Ww][Hh][Ee][Rr][Ee]$": { "$ref": "#/definitions/condition" },
        "^[Hh][Aa][Vv][Ii][Nn][Gg]$": { "$ref": "#/definitions/condition" },
        "^[Gg][Rr][Oo][Uu][Pp][Bb][Yy]$": { "$ref": "#/definitions/groupBy" },
        "^[Oo][Rr][Dd][Ee][Rr][Bb][Yy]$": { "$ref": "#/definitions/orderBy" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            { "$ref": "#/definitions/hasColumns" },
            {
              "not": { "propertyNames": { "not": { "pattern": "^[Ss][Ee][Ll][Ee][Cc][Tt]$" } } },
              "patternProperties": { "^[Ss][Ee][Ll][Ee][Cc][Tt]$": { "$ref": "#/definitions/hasColumns" } }
            }
